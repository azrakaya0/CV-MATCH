MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=cvmatch_db
AI_MODE=basic
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
SEED_DEMO_USERS=false
# Üretimde mutlaka değiştirin (en az 32 karakter):
JWT_SECRET=cvmatch-dev-secret-change-this-in-production-min-32-chars
# AI_MODE=basic  (hızlı, kural tabanlı eşleştirme) veya ai (embedding)
# --- E-posta bildirimleri (mesaj / yeni başvuru) — ayrı program indirmeniz gerekmez ---
# Şirketinizin veya Gmail/Outlook gibi bir sağlayıcının SMTP sunucu bilgilerini girin.
# Boş bırakırsanız uygulama çalışır; yalnızca e-posta gönderilmez.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=uygulama-sifresi-veya-api-key
# SMTP_FROM=CVMatch <noreply@sirket.com>
# APP_PUBLIC_URL=http://localhost:8000
